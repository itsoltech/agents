{
  "name": "itsolpowers",
  "version": "0.23.0",
  "description": "ITSOL engineering skills and bounded agents for Claude Code, Codex, OpenCode, and Pi",
  "license": "MIT",
  "author": "ITSOL Tech <dev@itsol.tech>",
  "type": "module",
  "main": ".opencode/plugins/itsolpowers.js",
  "keywords": [
    "pi-package",
    "itsol",
    "skills",
    "subagents",
    "workflow"
  ],
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".opencode",
    "agents",
    "context",
    "extensions",
    "hooks",
    "scripts",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "audit:context": "node ./scripts/audit-context.mjs",
    "check:agent-contracts": "node ./scripts/generate-agent-contracts.mjs --check",
    "generate:agent-contracts": "node ./scripts/generate-agent-contracts.mjs",
    "test:agent-contracts": "node ./scripts/test-agent-contracts.mjs",
    "test:context-audit": "node ./scripts/test-context-audit.mjs",
    "test:context-engineering": "node ./scripts/test-context-engineering.mjs",
    "test:context-package": "node ./scripts/test-context-package.mjs",
    "test:context-profiles": "node ./scripts/test-context-profiles.mjs",
    "test:context-rollback": "node ./scripts/test-context-rollback.mjs",
    "test:skill-layout": "node ./scripts/test-skill-layout.mjs",
    "validate:workflow-modes": "bash ./scripts/validate-workflow-modes.sh",
    "validate:canonical-references": "node ./scripts/test-canonical-references.mjs",
    "validate:context-engineering": "node ./scripts/validate-context-engineering.mjs",
    "validate:context-evals": "node ./scripts/validate-context-evals.mjs --self-test --result ./evals/results/example-public-result.json",
    "validate:execution-policy": "bash ./scripts/validate-execution-policy.sh",
    "test:subagent-stop": "node ./scripts/test-subagent-stop.mjs",
    "test:opencode-adapter": "node ./scripts/test-opencode-adapter.mjs",
    "test:pi-adapter": "node ./scripts/test-pi-adapter.mjs",
    "test:pi-runtime": "pi --offline --no-extensions -e ./scripts/test-pi-runtime.ts -p '/itsol-test-pi-runtime'",
    "test:execution-policy": "node ./scripts/test-execution-policy.mjs",
    "test:codex-agent-setup": "node ./scripts/test-codex-agent-setup.mjs"
  }
}
