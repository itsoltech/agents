{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powers.itsol.tech/schemas/model-result.schema.json",
  "title": "ITSOL Powers public context evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "repo_revision",
    "corpus",
    "model",
    "public_routing_output",
    "selections",
    "usage",
    "segment_results",
    "case_results",
    "repetitions",
    "pass_fail_reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_id": { "type": "string", "minLength": 1 },
    "repo_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "profile"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["frontier", "compatibility"] }
      }
    },
    "public_routing_output": { "type": "string", "maxLength": 10000 },
    "selections": {
      "$ref": "#/$defs/selections"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "segment_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment", "cases", "passed", "failed", "pass_rate"],
        "properties": {
          "segment": {
            "type": "string",
            "pattern": "^(overall|critical|category:[a-z0-9-]+|adapter:(claude|codex|opencode|pi)|profile:(frontier|compatibility))$"
          },
          "cases": { "type": "integer", "minimum": 1 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "repetition",
          "passed",
          "public_routing_output",
          "selections",
          "usage",
          "pass_fail_reasons"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "repetition": { "type": "integer", "minimum": 1 },
          "passed": { "type": "boolean" },
          "public_routing_output": { "type": "string", "maxLength": 10000 },
          "selections": { "$ref": "#/$defs/selections" },
          "usage": { "$ref": "#/$defs/usage" },
          "pass_fail_reasons": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "completed", "third_on_disagreement"],
      "properties": {
        "planned": { "const": 2 },
        "completed": { "type": "integer", "minimum": 2 },
        "third_on_disagreement": { "type": "boolean" }
      }
    },
    "pass_fail_reasons": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_process_skill", "domain_skills", "tools"],
      "properties": {
        "primary_process_skill": { "type": ["string", "null"] },
        "domain_skills": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
