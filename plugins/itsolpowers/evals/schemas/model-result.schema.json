{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powers.itsol.tech/schemas/model-result.schema.json",
  "title": "ITSOL Powers public context evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "repo_revision",
    "corpus",
    "model",
    "public_routing_output",
    "selections",
    "usage",
    "segment_results",
    "case_results",
    "repetitions",
    "pass_fail_reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_id": { "type": "string", "minLength": 1 },
    "repo_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "profile"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["frontier", "compatibility"] }
      }
    },
    "public_routing_output": { "type": "string", "maxLength": 10000 },
    "selections": {
      "$ref": "#/$defs/selections"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "segment_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment", "cases", "passed", "failed", "pass_rate"],
        "properties": {
          "segment": {
            "type": "string",
            "pattern": "^(overall|critical|category:[a-z0-9-]+|adapter:(claude|codex|opencode|pi)|profile:(frontier|compatibility))$"
          },
          "cases": { "type": "integer", "minimum": 1 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "repetition",
          "status",
          "effective_profile",
          "profile_provenance",
          "contract_decision",
          "evidence",
          "passed",
          "public_routing_output",
          "selections",
          "usage",
          "measurement",
          "pass_fail_reasons"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "repetition": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["complete", "partial", "unavailable", "blocked", "failed"] },
          "effective_profile": { "enum": ["frontier", "compatibility"] },
          "profile_provenance": { "$ref": "#/$defs/profile_provenance" },
          "contract_decision": { "$ref": "#/$defs/contract_decision" },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/evidence" }
          },
          "passed": { "type": "boolean" },
          "public_routing_output": { "type": "string", "maxLength": 10000 },
          "selections": { "$ref": "#/$defs/selections" },
          "usage": { "$ref": "#/$defs/usage" },
          "measurement": { "$ref": "#/$defs/measurement" },
          "pass_fail_reasons": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "completed", "third_on_disagreement"],
      "properties": {
        "planned": { "const": 2 },
        "completed": { "type": "integer", "minimum": 2 },
        "third_on_disagreement": { "type": "boolean" }
      }
    },
    "pass_fail_reasons": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_process_skill", "domain_skills", "tools"],
      "properties": {
        "primary_process_skill": { "type": ["string", "null"] },
        "domain_skills": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "profile_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requested_profile", "fallback"],
      "properties": {
        "source": { "enum": ["explicit-task", "explicit-environment", "validated-runtime-capability", "compatibility-fallback"] },
        "requested_profile": { "type": ["string", "null"], "enum": ["frontier", "compatibility", null] },
        "fallback": { "type": "boolean" }
      }
    },
    "contract_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing", "workflow_requirement", "execution_policy_requirement", "delegation", "protected_constraints"],
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_process_skill", "domain_skills"],
          "properties": {
            "primary_process_skill": { "type": ["string", "null"] },
            "domain_skills": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "workflow_requirement": { "enum": ["none", "governed", "autonomous-planned", "direct"] },
        "execution_policy_requirement": { "enum": ["none", "required"] },
        "delegation": { "enum": ["none", "inline", "subagents", "auto"] },
        "protected_constraints": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "source", "command", "artifact", "relates_to"],
      "properties": {
        "kind": { "enum": ["command", "test", "artifact", "observation", "measurement", "contract", "routing", "protected-constraint", "status"] },
        "status": { "enum": ["verified", "unavailable", "partial", "failed"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 160 },
        "command": { "type": "string", "minLength": 1, "maxLength": 320 },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 320 },
        "relates_to": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenizer", "harness", "model", "loaded_surfaces", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "tokenizer": { "type": "string", "minLength": 1, "maxLength": 160 },
        "harness": { "type": "string", "minLength": 1, "maxLength": 160 },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "loaded_surfaces": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
