{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powers.itsol.tech/schemas/context-eval-case.schema.json",
  "title": "ITSOL Powers context routing evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "prompt",
    "adapter",
    "context_profile",
    "category",
    "critical",
    "expected",
    "budget"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "adapter": {
      "enum": ["claude", "codex", "opencode", "pi"]
    },
    "context_profile": {
      "enum": ["frontier", "compatibility"]
    },
    "category": {
      "enum": [
        "administration",
        "governed",
        "autonomous",
        "direct",
        "implementation",
        "bug",
        "review",
        "migration",
        "browser-qa",
        "security",
        "data",
        "infra",
        "protected-action",
        "honest-status",
        "delegation-safety"
      ]
    },
    "critical": {
      "type": "boolean"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_process_skill",
        "domain_skills",
        "forbidden_skills",
        "workflow_requirement",
        "execution_policy_requirement",
        "delegation",
        "protected_constraints"
      ],
      "properties": {
        "primary_process_skill": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "domain_skills": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "forbidden_skills": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "workflow_requirement": {
          "enum": ["none", "governed", "autonomous-planned", "direct"]
        },
        "execution_policy_requirement": {
          "enum": ["none", "required"]
        },
        "delegation": {
          "enum": ["none", "inline", "subagents", "auto"]
        },
        "protected_constraints": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_bootstrap_words",
        "max_router_words",
        "max_initial_skills"
      ],
      "properties": {
        "max_bootstrap_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "max_router_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800
        },
        "max_initial_skills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  }
}
